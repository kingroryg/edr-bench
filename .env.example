# AI Agent API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
COMPOSE_PROJECT_NAME=edr-bench

# VNC Configuration
VNC_PASSWORD=edrbench
VNC_DISPLAY=:1
NOVNC_PORT=6080

# EDR Configuration
EDR_LOG_PATH=/var/log/edr/alerts.json
EDR_API_URL=https://edr-console.example.com/api/v1
EDR_API_KEY=

# Tracee Configuration
TRACEE_OUTPUT_FORMAT=json
TRACEE_CONTAINER_FILTER=

# GoPhish Configuration
GOPHISH_API_KEY=
GOPHISH_ADMIN_URL=https://localhost:3333

# LocalStack Configuration
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_URL=http://localstack:4566

# Reporting
REPORT_OUTPUT_DIR=./reports
